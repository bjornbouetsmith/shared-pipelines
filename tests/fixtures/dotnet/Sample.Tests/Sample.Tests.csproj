<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 is built on Microsoft.Testing.Platform, which is what the
         shared test action runs. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- Registers the coverage switches used by the shared test action. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sample.Library\Sample.Library.csproj" />
  </ItemGroup>

</Project>
